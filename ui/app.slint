// PreVocal — Vocal Bus Preamp
// Dark Studio Pro / Anodized Metal theme with Neon Purple accents.

import { ComboBox } from "std-widgets.slint";

component VerticalFader inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    callback changed(float);

    width: 44px;
    height: 220px;

    function normalized() -> float {
        return clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0.0, 1.0);
    }
    function thumbY() -> length {
        return (root.height - 18px) * (1.0 - root.normalized());
    }

    // Track
    Rectangle {
        width: 8px;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        background: Colors.darkgray;
        border-radius: 4px;
    }

    // Purple fill
    Rectangle {
        width: 8px;
        height: parent.height - root.thumbY();
        x: (parent.width - self.width) / 2;
        y: root.thumbY();
        background: #9D4EDD;
        border-radius: 4px;
    }

    // Thumb
    Rectangle {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: root.thumbY();
        background: Colors.darkgoldenrod;
        border-width: 2px;
        border-color: #C77DFF;
        border-radius: parent.width / 2;
    }

    TouchArea {
    width: parent.width;
    height: parent.height;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down || self.pressed) {
            root.value = clamp(
                root.maximum - (self.mouse-y / parent.height) * (root.maximum - root.minimum),
                root.minimum,
                root.maximum
            ).round();
            root.changed(root.value);
        }
    }
}
}

component ControlKnob inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    property <length> drag-start-y: 0px;
    property <float> drag-start-value: 0.0;
    property <bool> dragging: false;
    callback changed(float);

    width: 120px;
    height: 120px;

    function normalized() -> float {
        return clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0.0, 1.0);
    }

    // Outer ring
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.width / 2;
        background: #1E1E24;
        border-width: 3px;
        border-color: #3C096C;
    }

    // Inner face
    Rectangle {
        width: parent.width - 30px;
        height: parent.height - 30px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: (parent.width - 30px) / 2;
        background: #121214;
        border-width: 1px;
        border-color: rgba(157, 78, 221, 0.18);
    }

    // Indicator pointer
    Rectangle {
    width: 5px;
    height: 38px;
    x: (parent.width - self.width) / 2;
    y: parent.height / 2 - self.height;
    background: #C77DFF;
    border-radius: 2px;
    transform-origin: { x: self.width / 2, y: self.height };
    transform-rotation: -135deg + root.normalized() * 270deg;
}

    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragging = true;
                root.drag-start-y = self.mouse-y;
                root.drag-start-value = root.value;
                return true;
            } else if (e.kind == PointerEventKind.move && root.dragging) {
                let dy = self.mouse-y - root.drag-start-y;
                let range = root.maximum - root.minimum;
                root.value = clamp(root.drag-start-value - (dy / parent.height) * range, root.minimum, root.maximum);
                root.changed(root.value);
                return true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.dragging = false;
                return true;
            }
        }
    }
}

component PhaseToggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 150px;
    height: 52px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 14px;
        background: root.checked ? #3C096C : #1E1E24;
        border-width: 2px;
        border-color: root.checked ? #9D4EDD : rgba(157, 78, 221, 0.3);
    }

    // LED indicator
    Rectangle {
        width: 10px;
        height: 10px;
        x: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.checked ? #C77DFF : #3C096C;
        drop-shadow-blur: root.checked ? 8px : 0px;
        drop-shadow-color: #9D4EDD;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 0px;
    }

    Text {
        x: 36px;
        y: (parent.height - self.height) / 2;
        text: root.checked ? "PHASE 180°" : "PHASE 0°";
        color: root.checked ? #FFFFFF : #A0A0B0;
        font-size: 14px;
        font-weight: 600;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component LevelMeter inherits Rectangle {
    in-out property <float> level: 0.0;
    in-out property <float> peak: 0.0;

    width: 14px;
    height: 150px;

    // Green below -6 dB, yellow -6..-3 dB, red above -3 dB (clip zone).
    // The level is a 0..1 mapping of the dBFS scale (see level_to_meter in main.rs).
    function colorFor() -> color {
        return root.level < 0.9 ? #4CAF50 : (root.level < 0.95 ? #FFEB3B : #EF5350);
    }
    function fillHeight() -> length {
        return clamp(root.level, 0.0, 1.0) * root.height;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 7px;
        background: #2a2a30;
        clip: true;

        // Zone guides: green (0..-6 dB), yellow (-6..-3 dB), red (-3..0 dB)
        Rectangle {
            width: parent.width;
            height: parent.height * 0.9;
            y: parent.height * 0.1;
            background: rgba(76, 175, 80, 0.18);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: parent.height * 0.05;
            background: rgba(255, 235, 59, 0.24);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: 0px;
            background: rgba(239, 83, 80, 0.34);
        }

        // Level fill, colored by the current zone
        Rectangle {
            width: parent.width;
            height: root.fillHeight();
            y: parent.height - self.height;
            background: root.colorFor();
        }

        // Peak hold marker
        Rectangle {
            width: parent.width;
            height: 2px;
            y: parent.height - clamp(root.peak, 0.0, 1.0) * parent.height;
            background: root.peak >= 0.95 ? #EF5350 : #E0E0E0;
        }
    }
}

export component PreVocalUI inherits Window {
    preferred-width: 1000px;
    preferred-height: 640px;
    title: "PreVocal — Vocal Bus Preamp";
    background: #121214;
    // When embedded in a DAW the host owns the frame: no title bar, no
    // close/minimize/maximize buttons (the plugin editor sets this to true).
    in-out property <bool> plugin-mode: false;
    no-frame: root.plugin-mode;

    in-out property <float> drive: 0.0;
    in-out property <float> hpf: 20.0;
    in-out property <float> air: 0.0;
    in-out property <float> output-trim: 0.0;
    in-out property <bool> phase-flip: false;
    in-out property <float> input-level: 0.0;
    in-out property <float> output-level: 0.0;
    in-out property <float> input-peak: 0.0;
    in-out property <float> output-peak: 0.0;
    in-out property <[string]> available-drivers: [];
    in-out property <int> driver-index: -1;
    in-out property <[string]> available-inputs: [];
    in-out property <int> input-index: -1;
    in-out property <[string]> available-outputs: [];
    in-out property <int> output-index: -1;
    in-out property <string> audio-status: "";
    in-out property <bool> audio-running: false;
    // Hidden by the plugin editor (audio is handled by the DAW host), shown in the standalone.
    in-out property <bool> audio-controls-visible: true;

    callback drive-changed(float);
    callback hpf-changed(float);
    callback air-changed(float);
    callback output-trim-changed(float);
    callback phase-flip-changed(bool);
    callback driver-selected(string);
    callback input-selected(string);
    callback output-selected(string);
    callback restart-clicked();
    callback refresh-clicked();

    VerticalLayout {
        padding: 26px;
        spacing: 20px;
        alignment: LayoutAlignment.stretch;
        height: 100%;

        // Header
            
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: LayoutAlignment.start;
            cross-axis-alignment: center;

            

           

            Text {
                text: "PreVocal";
                font-size: 34px;
                font-weight: 700;
                color: #FFFFFF;
                vertical-alignment: center;
            }
            Text {
                text: "Vocal Bus Preamp";
                font-size: 14px;
                color: #A0A0B0;
                vertical-alignment: center;
            }
            Rectangle {
                width: 1px;
                height: 32px;
                background: #3C096C;
            }
            Text {
                text: "By Du Mestre";
                font-size: 16px;
                color: #A0A0B0;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                width: 300px;
                background: transparent;
            }
            Text {
                text: "V1.0";
                font-size: 12px;
                color: #A0A0B0;
                vertical-alignment: center;
            }
        }
    
    

        // Audio driver / device selector (standalone only)
        Rectangle {
            visible: root.audio-controls-visible;
            border-radius: 14px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                // Row 1: driver (ASIO, WASAPI, ...)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: center;

                    Text {
                        text: "DRIVER";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 220px;
                        model: root.available-drivers;
                        current-index: root.driver-index;
                        selected(v) => {
                            root.driver-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                    Rectangle {
                        width: 1px;
                        height: 26px;
                        background: #3C096C;
                    }
                    Text {
                        text: root.audio-status;
                        font-size: 12px;
                        color: root.audio-running ? #4CAF50 : (root.audio-status == "" ? #A0A0B0 : #EF5350);
                        vertical-alignment: center;
                    }
                    // Refresh device list
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_refresh.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #3C096C;
                        Text {
                            text: "↻";
                            font-size: 16px;
                            color: #C77DFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ta_refresh := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.refresh-clicked(); }
                        }
                    }
                    // Restart audio engine (applies selected devices)
                    Rectangle {
                        width: 90px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_restart.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #9D4EDD;
                        Text {
                            text: "RESTART";
                            font-size: 12px;
                            font-weight: 600;
                            color: #C77DFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ta_restart := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.restart-clicked(); }
                        }
                    }
                }

                // Row 2: output + input devices of the selected driver
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: center;

                    Text {
                        text: "SAÍDA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-outputs;
                        current-index: root.output-index;
                        selected(v) => {
                            root.output-selected(v);
                        }
                    }
                    Rectangle {
                        width: 12px;
                        background: transparent;
                    }
                    Text {
                        text: "ENTRADA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-inputs;
                        current-index: root.input-index;
                        selected(v) => {
                            root.input-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                }
            }
        }

        // Main control panel
        Rectangle {
            border-radius: 22px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                height: 100%;

                // Drive status image (off / half / full), centered at the top of the panel
                HorizontalLayout {
                    alignment: LayoutAlignment.center;

                    Image {
                        width: 120px;
                        height: 180px;
                        image-fit: contain;
                        source: root.drive <= 0.0 ? @image-url("../src/icons/off.png")
                              : root.drive >= 24.0 ? @image-url("../src/icons/100.png")
                              : @image-url("../src/icons/50.png");
                    }
                }

                HorizontalLayout {
                    spacing: 20px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                // Input meter (left)
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    width: 36px;
                    LevelMeter {
                        level: root.input-level;
                        peak: root.input-peak;
                    }
                    Text { text: "IN"; font-size: 11px; color: #A0A0B0; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text { text: "DRIVE"; font-size: 13px; color: #A0A0B0; }
                    VerticalFader {
                        minimum: 0.;
                        maximum: 24.0;
                        value <=> root.drive;
                        changed(v) => { root.drive-changed(v); }
                    }
                    Text { text: root.drive.round() + " dB"; font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text { text: "OUTPUT TRIM"; font-size: 13px; color: #A0A0B0; }
                    VerticalFader {
                        minimum: -12.0;
                        maximum: 12.0;
                        value <=> root.output-trim;
                        changed(v) => { root.output-trim-changed(v); }
                    }
                    Text { text: root.output-trim + " dB"; font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text { text: "HPF"; font-size: 13px; color: #A0A0B0; }
                    ControlKnob {
                        minimum: 20.0;
                        maximum: 200.0;
                        value <=> root.hpf;
                        changed(v) => { root.hpf-changed(v); }
                    }
                    Text { text: root.hpf; font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text { text: "AIR"; font-size: 13px; color: #A0A0B0; }
                    ControlKnob {
                        minimum: 0.0;
                        maximum: 6.0;
                        value <=> root.air;
                        changed(v) => { root.air-changed(v); }
                    }
                    Text { text: root.air; font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    horizontal-stretch: 1;

                    PhaseToggle {
                        checked <=> root.phase-flip;
                        toggled(v) => { root.phase-flip-changed(v); }
                    }
                    Text { text: "PHASE FLIP"; font-size: 13px; color: #A0A0B0; }
                }

                // Output meter (right)
                VerticalLayout {
                    spacing: 8px;
                    alignment: center;
                    width: 36px;
                    LevelMeter {
                        level: root.output-level;
                        peak: root.output-peak;
                    }
                    Text { text: "OUT"; font-size: 11px; color: #A0A0B0; }
                }
                }
            }
        }
    }
}
