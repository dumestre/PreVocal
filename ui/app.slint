// PreVocal — Vocal Bus Preamp
// Dark Studio Pro / Anodized Metal theme with Neon Purple accents.

import { ComboBox, LineEdit } from "std-widgets.slint";
import { ControlKnob } from "knob.slint";
import { VerticalFader } from "fader.slint";

component LevelMeter inherits Rectangle {
    in-out property <float> level: 0.0;
    in-out property <float> peak: 0.0;

    preferred-width: 14px;
    preferred-height: 150px;

    // Green below -6 dB, yellow -6..-3 dB, red above -3 dB (clip zone).
    // The level is a 0..1 mapping of the dBFS scale (see level_to_meter in main.rs).
    function colorFor() -> color {
        return root.level < 0.9 ? #4CAF50 : (root.level < 0.95 ? #FFEB3B : #EF5350);
    }
    function fillHeight() -> length {
        return clamp(root.level, 0.0, 1.0) * root.height;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 7px;
        background: #2a2a30;
        clip: true;

        // Zone guides: green (0..-6 dB), yellow (-6..-3 dB), red (-3..0 dB)
        Rectangle {
            width: parent.width;
            height: parent.height * 0.9;
            y: parent.height * 0.1;
            background: rgba(76, 175, 80, 0.18);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: parent.height * 0.05;
            background: rgba(255, 235, 59, 0.24);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: 0px;
            background: rgba(239, 83, 80, 0.34);
        }

        // Level fill, colored by the current zone
        Rectangle {
            width: parent.width;
            height: root.fillHeight();
            y: parent.height - self.height;
            background: root.colorFor();
        }

        // Peak hold marker
        Rectangle {
            width: parent.width;
            height: 2px;
            y: parent.height - clamp(root.peak, 0.0, 1.0) * parent.height;
            background: root.peak >= 0.95 ? #EF5350 : #E0E0E0;
        }
    }
}

export component PreVocalUI inherits Window {
    preferred-width: 1000px;
    preferred-height: 720px;
    title: "PreVocal — Vocal Bus Preamp";
    background: #121214;
    // When embedded in a DAW the host owns the frame: no title bar, no
    // close/minimize/maximize buttons (the plugin editor sets this to true).
    in-out property <bool> plugin-mode: false;
    no-frame: root.plugin-mode;

    in-out property <float> drive: 0.0;
    in-out property <float> hpf: 20.0;
    in-out property <float> lpf: 20000.0;
    in-out property <float> air: 0.0;
    in-out property <float> comp-thresh: -18.0;
    in-out property <float> comp-ratio: 3.0;
    in-out property <float> comp-attack: 5.0;
    in-out property <float> comp-release: 100.0;
    in-out property <float> comp-makeup: 0.0;
    in-out property <float> delay-time: 300.0;
    in-out property <float> delay-feedback: 30.0;
    in-out property <float> delay-mix: 15.0;
    in-out property <float> output-trim: 0.0;
    in-out property <float> input-level: 0.0;
    in-out property <float> output-level: 0.0;
    in-out property <float> input-peak: 0.0;
    in-out property <float> output-peak: 0.0;
    in-out property <[string]> available-drivers: [];
    in-out property <int> driver-index: -1;
    in-out property <[string]> available-inputs: [];
    in-out property <int> input-index: -1;
    in-out property <[string]> available-outputs: [];
    in-out property <int> output-index: -1;
    in-out property <string> audio-status: "";
    in-out property <bool> audio-running: false;
    // Hidden by the plugin editor (audio is handled by the DAW host), shown in the standalone.
    in-out property <bool> audio-controls-visible: true;

    callback drive-changed(float);
    callback hpf-changed(float);
    callback lpf-changed(float);
    callback air-changed(float);
    callback comp-thresh-changed(float);
    callback comp-ratio-changed(float);
    callback comp-attack-changed(float);
    callback comp-release-changed(float);
    callback comp-makeup-changed(float);
    callback delay-time-changed(float);
    callback delay-feedback-changed(float);
    callback delay-mix-changed(float);
    callback output-trim-changed(float);
    callback driver-selected(string);
    callback input-selected(string);
    callback output-selected(string);
    callback restart-clicked();
    callback refresh-clicked();

    // Formata um valor de frequência como um knob real: 20 Hz, 200 Hz, 2 kHz, 12.5 kHz
    pure function freqLabel(f: float) -> string {
        if f >= 1000.0 {
            let k = f / 1000.0;
            let v = k >= 10.0 ? round(k) : round(k * 10.0) / 10.0;
            return v + " kHz";
        }
        return round(f) + " Hz";
    }

    pure function formatDb(v: float) -> string {
        return round(v * 10.0) / 10.0 + " dB";
    }

    pure function formatMs(v: float) -> string {
        return round(v * 10.0) / 10.0 + " ms";
    }

    pure function ratioLabel(r: float) -> string {
        return round(r * 10.0) / 10.0 + " :1";
    }

    VerticalLayout {
        padding: 26px;
        spacing: 20px;
        alignment: LayoutAlignment.center;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        height: 100%;

        // Header
            
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: LayoutAlignment.start;
            cross-axis-alignment: center;

            

           

            Image {
                width: 130px;
                height: 56px;
                image-fit: contain;
                source: @image-url("../src/icons/prevocallogo.png");
            }
            
            
            Rectangle {
                width: 1px;
                height: 32px;
                background: #3C096C;
            }
            Text {
                text: "By Du Mestre";
                font-size: 16px;
                color: #A0A0B0;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                width: 300px;
                background: transparent;
            }
            Text {
                text: "V1.0";
                font-size: 12px;
                color: #A0A0B0;
                vertical-alignment: center;
            }
        }
    
    

        // Audio driver / device selector (standalone only)
        if root.audio-controls-visible: Rectangle {
            border-radius: 14px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                // Row 1: driver (ASIO, WASAPI, ...)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: center;
 
                    Text {
                        text: "DRIVER";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 220px;
                        model: root.available-drivers;
                        current-index: root.driver-index;
                        selected(v) => {
                            root.driver-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                    Rectangle {
                        width: 1px;
                        height: 26px;
                        background: #3C096C;
                    }
                    Text {
                        text: root.audio-status;
                        font-size: 12px;
                        color: root.audio-running ? #4CAF50 : (root.audio-status == "" ? #A0A0B0 : #EF5350);
                        vertical-alignment: center;
                    }
                    // Refresh device list
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_refresh.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #3C096C;
                        Text {
                            text: "↻";
                            font-size: 16px;
                            color: #C77DFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ta_refresh := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.refresh-clicked(); }
                        }
                    }
                    // Restart audio engine (applies selected devices)
                    Rectangle {
                        width: 90px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_restart.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #9D4EDD;
                        Text {
                            text: "RESTART";
                            font-size: 12px;
                            font-weight: 600;
                            color: #C77DFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ta_restart := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.restart-clicked(); }
                        }
                    }
                }

                // Row 2: output + input devices of the selected driver
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    Text {
                        text: "SAÍDA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-outputs;
                        current-index: root.output-index;
                        selected(v) => {
                            root.output-selected(v);
                        }
                    }
                    Rectangle {
                        width: 12px;
                        background: transparent;
                    }
                    Text {
                        text: "ENTRADA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-inputs;
                        current-index: root.input-index;
                        selected(v) => {
                            root.input-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                }
            }
        }

        // Main control panel
        Rectangle {
            border-radius: 22px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            // Front panel face (frente.jpg), clipped to the rounded corners
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: @image-url("../src/icons/frente.png");
                image-fit: cover;
            }

            // Faceplate screws on top of the panel image, one in each corner
            Image {
                width: 26px;
                height: 26px;
                x: 14px;
                y: 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 15deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: parent.width - self.width - 14px;
                y: 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 105deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: 14px;
                y: parent.height - self.height - 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 210deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 315deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: LayoutAlignment.space-between;
                cross-axis-alignment: CrossAxisAlignment.stretch;
                height: 100%;

                // Input meter (left edge, full height)
                VerticalLayout {
                    padding-bottom: 50px;
                    spacing: 8px;
                    alignment: LayoutAlignment.end;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    width: 25px;
                    vertical-stretch: 1;
                    LevelMeter {
                        accessible-role: AccessibleRole.none;
                        level: root.input-level;
                        peak: root.input-peak;
                        width: 14px;
                        vertical-stretch: 1;
                    }
                    Text { text: "IN";
                        vertical-alignment: TextVerticalAlignment.top; font-size: 11px;
                        horizontal-alignment: TextHorizontalAlignment.center; color: #A0A0B0; }
                }

                VerticalLayout {
                    spacing: 20px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                // Drive status image (off / half / full), centered at the top of the panel
                HorizontalLayout {
                    alignment: LayoutAlignment.center;

                   
                }

                // Preamp section: drive, filters, air and output trim
                VerticalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    Rectangle {
                        background: #2f4f4f8f;
                        border-radius: 6px;
                        drop-shadow-blur: 0px;
                        drop-shadow-color: #2f4f4f8f;
                        drop-shadow-offset-x: 0px;
                        drop-shadow-offset-y: 0px;
                        drop-shadow-spread: 0px; 
                    Text {
                        text: "PREAMP";
                        font-size: 11px;
                        color: #A0A0B0;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        letter-spacing: 3px;
                    }
                }

                HorizontalLayout {
                    spacing: 20px;
                    alignment: LayoutAlignment.center;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;

                    Text { text: "DRIVE"; font-size: 13px; color: #A0A0B0; }
                    VerticalFader {
                        minimum: 0.;
                        height: 100px;
                        maximum: 24.0;
                        value <=> root.drive;
                        changed(v) => { root.drive-changed(v); }
                    }
                    Text { text: root.drive.round() + " dB"; font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;

                    Text { text: "HPF"; font-size: 13px; color: #A0A0B0; }
                    ControlKnob {
                        minimum: 20.0;
                        maximum: 200.0;
                        default-value: 20.0;
                        value <=> root.hpf;
                        changed(v) => { root.hpf-changed(v); }
                    }
                    Text { text: root.freqLabel(root.hpf); font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;

                    Text { text: "LPF"; font-size: 13px; color: #A0A0B0; }
                    ControlKnob {
                        minimum: 500.0;
                        maximum: 20000.0;
                        default-value: 20000.0;
                        value <=> root.lpf;
                        changed(v) => { root.lpf-changed(v); }
                    }
                    Text { text: root.freqLabel(root.lpf); font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;

                    Text { text: "AIR"; font-size: 13px; color: #A0A0B0; }
                    ControlKnob {
                        minimum: 0.0;
                        maximum: 6.0;
                        default-value: 0.0;
                        value <=> root.air;
                        changed(v) => { root.air-changed(v); }
                    }
                    Text { text: root.formatDb(root.air); font-size: 14px; color: #C77DFF; }
                }

                VerticalLayout {
                    spacing: 16px;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    horizontal-stretch: 1;

                    Text { text: "TRIM"; font-size: 13px; color: #A0A0B0; }
                    VerticalFader {
                        minimum: -12.0;
                        height: 100px;
                        maximum: 12.0;
                        value <=> root.output-trim;
                        changed(v) => { root.output-trim-changed(v); }
                    }
                    Text { text: root.output-trim + " dB"; font-size: 14px; color: #C77DFF; }
                }
                }
                }

                // Compressor section
                
                VerticalLayout {
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        background: #2f4f4f8f;
                        border-radius: 6px;
                        drop-shadow-blur: 0px;
                        drop-shadow-color: #2f4f4f8f;
                        drop-shadow-offset-y: 0px; 
                    Text {
                        text: "COMPRESSOR";
                        font-size: 11px;
                        color: #A0A0B0;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        letter-spacing: 3px;
                    }
                }

                    HorizontalLayout {
                        spacing: 30px;
                        alignment: LayoutAlignment.center;

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "THRESH"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: -60.0;
                                maximum: 0.0;
                                default-value: -18.0;
                                value <=> root.comp-thresh;
                                changed(v) => { root.comp-thresh-changed(v); }
                            }
                            Text { text: root.formatDb(root.comp-thresh); font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "RATIO"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 1.0;
                                maximum: 20.0;
                                default-value: 3.0;
                                value <=> root.comp-ratio;
                                changed(v) => { root.comp-ratio-changed(v); }
                            }
                            Text { text: root.ratioLabel(root.comp-ratio); font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "ATTACK"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 0.1;
                                maximum: 100.0;
                                default-value: 5.0;
                                value <=> root.comp-attack;
                                changed(v) => { root.comp-attack-changed(v); }
                            }
                            Text { text: root.formatMs(root.comp-attack); font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "RELEASE"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 10.0;
                                maximum: 1000.0;
                                default-value: 100.0;
                                value <=> root.comp-release;
                                changed(v) => { root.comp-release-changed(v); }
                            }
                            Text { text: root.formatMs(root.comp-release); font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "MAKEUP"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 0.0;
                                maximum: 24.0;
                                default-value: 0.0;
                                value <=> root.comp-makeup;
                                changed(v) => { root.comp-makeup-changed(v); }
                            }
                            Text { text: root.formatDb(root.comp-makeup); font-size: 13px; color: #C77DFF; }
                        }
                    }
                }

                // Stereo delay section
                VerticalLayout {
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        background: #2f4f4f8f;
                        border-radius: 6px;
                        drop-shadow-blur: 0px;
                        drop-shadow-color: #2f4f4f8f;
                        drop-shadow-offset-y: 0px; 
                    Text {
                        text: "DELAY";
                        font-size: 11px;
                        color: #A0A0B0;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        letter-spacing: 3px;
                    }
                }

                    HorizontalLayout {
                        spacing: 30px;
                        alignment: LayoutAlignment.center;

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "TIME"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 1.0;
                                maximum: 1000.0;
                                default-value: 300.0;
                                value <=> root.delay-time;
                                changed(v) => { root.delay-time-changed(v); }
                            }
                            Text { text: root.formatMs(root.delay-time); font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "FEEDBACK"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 0.0;
                                maximum: 90.0;
                                default-value: 30.0;
                                value <=> root.delay-feedback;
                                changed(v) => { root.delay-feedback-changed(v); }
                            }
                            Text { text: round(root.delay-feedback) + " %"; font-size: 13px; color: #C77DFF; }
                        }

                        VerticalLayout {
                            spacing: 10px;
                            alignment: center;
                            cross-axis-alignment: CrossAxisAlignment.center;

                            Text { text: "MIX"; font-size: 12px; color: #A0A0B0; }
                            ControlKnob {
                                minimum: 0.0;
                                maximum: 100.0;
                                default-value: 15.0;
                                value <=> root.delay-mix;
                                changed(v) => { root.delay-mix-changed(v); }
                            }
                            Text { text: round(root.delay-mix) + " %"; font-size: 13px; color: #C77DFF; }
                        }
                    }
                }
                }

                // Output meter (right edge, full height)
                VerticalLayout {
                    padding-bottom: 50px;
                    spacing: 8px;
                    alignment: LayoutAlignment.end;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    width: 25px;
                    vertical-stretch: 0;
                    LevelMeter {
                        level: root.output-level;
                        peak: root.output-peak;
                        width: 14px;
                        vertical-stretch: 1;
                    }
                    Text { overflow: TextOverflow.clip;
                        text: "OUT";
                        vertical-alignment: TextVerticalAlignment.bottom;
                        wrap: TextWrap.no-wrap; font-size: 11px;
                        horizontal-alignment: TextHorizontalAlignment.center; color: #A0A0B0; }
                }
            }
        }
    }
}
