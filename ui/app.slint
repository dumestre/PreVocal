// PreVocal — Vocal Bus Preamp
// Dark Studio Pro / Anodized Metal theme with Neon Purple accents.

import { ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { ControlKnob } from "knob.slint";
import { VerticalFader } from "fader.slint";

component LevelMeter inherits Rectangle {
    in-out property <float> level: 0.0;
    in-out property <float> peak: 0.0;

    preferred-width: 14px;
    preferred-height: 150px;

    // Green below -6 dB, yellow -6..-3 dB, red above -3 dB (clip zone).
    // The level is a 0..1 mapping of the dBFS scale (see level_to_meter in main.rs).
    function colorFor() -> color {
        return root.level < 0.9 ? #4CAF50 : (root.level < 0.95 ? #FFEB3B : #EF5350);
    }
    function fillHeight() -> length {
        return clamp(root.level, 0.0, 1.0) * root.height;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 7px;
        background: #2a2a30;
        clip: true;

        // Zone guides: green (0..-6 dB), yellow (-6..-3 dB), red (-3..0 dB)
        Rectangle {
            width: parent.width;
            height: parent.height * 0.9;
            y: parent.height * 0.1;
            background: rgba(76, 175, 80, 0.18);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: parent.height * 0.05;
            background: rgba(255, 235, 59, 0.24);
        }
        Rectangle {
            width: parent.width;
            height: parent.height * 0.05;
            y: 0px;
            background: rgba(239, 83, 80, 0.34);
        }

        // Level fill, colored by the current zone
        Rectangle {
            width: parent.width;
            height: root.fillHeight();
            y: parent.height - self.height;
            background: root.colorFor();
        }

        // Peak hold marker
        Rectangle {
            width: parent.width;
            height: 2px;
            y: parent.height - clamp(root.peak, 0.0, 1.0) * parent.height;
            background: root.peak >= 0.95 ? #EF5350 : #E0E0E0;
        }
    }
}

// Meter with a dB scale next to it: 0..1 maps to -60 dB (bottom) .. 0 dB (top).
component MeterWithScale inherits Rectangle {
    in-out property <float> level: 0.0;
    in-out property <float> peak: 0.0;

    preferred-width: 50px;
    preferred-height: 150px;

    // Vertical position of a scale line/label given its fraction of the
    // meter height (0 = top = 0 dB, 1 = bottom = -60 dB).
    function lineY(f: float) -> length {
        return root.height * f;
    }
    function labelY(f: float) -> length {
        return root.height * f - 5px;
    }

    LevelMeter {
        x: 0px;
        y: 0px;
        width: 14px;
        height: parent.height;
        accessible-role: AccessibleRole.none;
        level: root.level;
        peak: root.peak;
    }

    // Scale ticks + labels at 0, -12, -24, -36, -48 and -60 dB
    Rectangle { x: 16px; y: root.lineY(0.0); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(0.0); text: "0"; font-size: 8px; color: #707078; }
    Rectangle { x: 16px; y: root.lineY(0.2); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(0.2); text: "-12"; font-size: 8px; color: #707078; }
    Rectangle { x: 16px; y: root.lineY(0.4); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(0.4); text: "-24"; font-size: 8px; color: #707078; }
    Rectangle { x: 16px; y: root.lineY(0.6); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(0.6); text: "-36"; font-size: 8px; color: #707078; }
    Rectangle { x: 16px; y: root.lineY(0.8); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(0.8); text: "-48"; font-size: 8px; color: #707078; }
    Rectangle { x: 16px; y: root.lineY(1.0); width: 4px; height: 1px; background: #707078; }
    Text { x: 22px; y: root.labelY(1.0); text: "-60"; font-size: 8px; color: #707078; }
}

// On/off switch for a DSP section (compressor / delay). `on` reflects the
// section's ACTIVE state (purple "ON" = the effect is engaged, gray "OFF" =
// it is bypassed), so callers bind it to `!bypass`. The preamp has no bypass:
// it is the heart of the plugin and always runs.
component SectionToggle inherits Rectangle {
    in-out property <bool> on: false;
    callback toggled(bool);

    width: 30px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? #9D4EDD : #2a2a30;
    border-width: 1px;
    border-color: root.on ? #C77DFF : #5A5A66;

    Text {
        text: root.on ? "ON" : "OFF";
        font-size: 9px;
        font-weight: 600;
        color: root.on ? #121214 : #A0A0B0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(!root.on); }
    }
}

// Label + knob + value readout stacked column, reused inside the section cards.
component KnobCol inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> default-value;
    in-out property <float> value;
    in property <string> display: "";
    callback changed(float);

    spacing: 10px;
    alignment: center;
    cross-axis-alignment: CrossAxisAlignment.center;

    Text { text: root.label; font-size: 12px; color: #A0A0B0; }
    ControlKnob {
        minimum: root.minimum;
        maximum: root.maximum;
        default-value: root.default-value;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
    Text { text: root.display; font-size: 13px; color: #C77DFF; }
}

// Label + fader + value readout stacked column.
component FaderCol inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <string> display: "";
    callback changed(float);

    spacing: 10px;
    alignment: center;
    cross-axis-alignment: CrossAxisAlignment.center;

    Text { text: root.label; font-size: 12px; color: #A0A0B0; }
    VerticalFader {
        minimum: root.minimum;
        height: 110px;
        maximum: root.maximum;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
    Text { text: root.display; font-size: 13px; color: #C77DFF; }
}

// Section header strip: title + optional on/off toggle.
component SectionHeader inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> show-toggle: true;
    callback toggled(bool);

    background: #2f4f4f8f;
    border-radius: 6px;

    HorizontalLayout {
        width: parent.width;
        spacing: 10px;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;
        Text {
            text: root.label;
            font-size: 11px;
            color: #A0A0B0;
            font-family: "poppins";
            horizontal-alignment: TextHorizontalAlignment.center;
            letter-spacing: 3px;
        }
        if root.show-toggle: SectionToggle {
            height: 15px;
            on: root.on;
            width: 25px;
            toggled(v) => { root.toggled(v); }
        }
    }
}

export component PreVocalUI inherits Window {
    
    title: "PreVocal — Vocal Bus Preamp";
    background: #121214;
    // Force the std-widgets theme to dark: in a DAW the plugin view is a
    // child window that doesn't report the OS color scheme, so the widgets
    // would otherwise fall back to the bright (white) theme.
    init => { Palette.color-scheme = ColorScheme.dark; }
    // When embedded in a DAW the host owns the frame: no title bar, no
    // close/minimize/maximize buttons (the plugin editor sets this to true).
    in-out property <bool> plugin-mode: false;
    no-frame: root.plugin-mode;

    in-out property <float> drive: 0.0;
    in-out property <float> hpf: 20.0;
    in-out property <float> lpf: 20000.0;
    max-height: 720px;
    max-width: 900px;
    in-out property <float> air: 0.0;
    in-out property <float> tube-character: 0.35;
    in-out property <float> tube-sag: 0.0;
    in-out property <float> comp-thresh: -18.0;
    in-out property <float> comp-ratio: 3.0;
    in-out property <float> comp-attack: 5.0;
    in-out property <float> comp-release: 100.0;
    in-out property <float> comp-makeup: 0.0;
    in-out property <bool> comp-bypass: false;
    in-out property <float> delay-time: 300.0;
    in-out property <float> delay-feedback: 30.0;
    in-out property <float> delay-mix: 15.0;
    in-out property <bool> delay-bypass: false;
    in-out property <float> reverb-size: 0.5;
    in-out property <float> reverb-damping: 0.5;
    in-out property <float> reverb-mix: 15.0;
    in-out property <bool> reverb-bypass: true;
    in-out property <float> output-trim: 0.0;
    in-out property <float> input-level: 0.0;
    in-out property <float> output-level: 0.0;
    in-out property <float> input-peak: 0.0;
    in-out property <float> output-peak: 0.0;
    in-out property <[string]> available-drivers: [];
    in-out property <int> driver-index: -1;
    in-out property <[string]> available-inputs: [];
    in-out property <int> input-index: -1;
    in-out property <[string]> available-outputs: [];
    in-out property <int> output-index: -1;
    in-out property <string> audio-status: "";
    in-out property <bool> audio-running: false;
    // Hidden by the plugin editor (audio is handled by the DAW host), shown in the standalone.
    in-out property <bool> audio-controls-visible: true;
    in-out property <[string]> preset-names: [];
    in-out property <int> preset-index: 0;

    callback drive-changed(float);
    callback hpf-changed(float);
    callback lpf-changed(float);
    callback air-changed(float);
    callback tube-character-changed(float);
    callback tube-sag-changed(float);
    callback comp-thresh-changed(float);
    callback comp-ratio-changed(float);
    callback comp-attack-changed(float);
    callback comp-release-changed(float);
    callback comp-makeup-changed(float);
    callback comp-bypass-toggled(bool);
    callback delay-time-changed(float);
    callback delay-feedback-changed(float);
    callback delay-mix-changed(float);
    callback delay-bypass-toggled(bool);
    callback reverb-size-changed(float);
    callback reverb-damping-changed(float);
    callback reverb-mix-changed(float);
    callback reverb-bypass-toggled(bool);
    callback output-trim-changed(float);
    callback driver-selected(string);
    callback input-selected(string);
    callback output-selected(string);
    callback restart-clicked();
    callback refresh-clicked();
    callback preset-selected(int);

    // Keeps the dropdown text and `preset-index` in sync. Writing the ComboBox's
    // `current-index` directly is required: a one-way binding on it is silently
    // broken the first time the user picks an item from the popup.
    public function sync-preset-index(index: int) {
        root.preset-index = index;
        presetCombo.current-index = index;
    }

    // Formata um valor de frequência como um knob real: 20 Hz, 200 Hz, 2 kHz, 12.5 kHz
    pure function freqLabel(f: float) -> string {
        if f >= 1000.0 {
            let k = f / 1000.0;
            let v = k >= 10.0 ? round(k) : round(k * 10.0) / 10.0;
            return v + " kHz";
        }
        return round(f) + " Hz";
    }

    pure function formatDb(v: float) -> string {
        return round(v * 10.0) / 10.0 + " dB";
    }

    pure function formatMs(v: float) -> string {
        return round(v * 10.0) / 10.0 + " ms";
    }

    pure function ratioLabel(r: float) -> string {
        return round(r * 10.0) / 10.0 + " :1";
    }

    VerticalLayout {
        padding: 26px;
        spacing: 20px;
        alignment: LayoutAlignment.center;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        height: 100%;

        // Header
            
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: LayoutAlignment.start;
            cross-axis-alignment: center;

            

           

            Image {
                width: 130px;
                height: 56px;
                image-fit: contain;
                source: @image-url("../src/icons/prevocallogo.png");
            }

        
            
                Text {
                text: "V1.0";
                font-size: 12px;
                horizontal-alignment: TextHorizontalAlignment.center;
                color: #A0A0B0;
                    font-family: "poppins";
                vertical-alignment: TextVerticalAlignment.bottom;
            }
        
        
            
            
            Rectangle {
                width: 1px;
                height: 32px;
                background: #3C096C;
            }
            Text {
                text: "By Du Mestre";
                font-size: 16px;
                color: #A0A0B0;
                font-family: "poppins";
                vertical-alignment: center;
            }
           
        }
    
    

        // Audio driver / device selector (standalone only)
        if root.audio-controls-visible: Rectangle {
            border-radius: 14px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                // Row 1: driver (ASIO, WASAPI, ...)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: center;
 
                    Text {
                        text: "DRIVER";
                        font-size: 12px;
                        color: #A0A0B0;
                        font-family: "";
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 220px;
                        model: root.available-drivers;
                        current-index: root.driver-index;
                        selected(v) => {
                            root.driver-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                    Rectangle {
                        width: 1px;
                        height: 26px;
                        background: #3C096C;
                    }
                    Text {
                        text: root.audio-status;
                        font-size: 12px;
                        color: root.audio-running ? #4CAF50 : (root.audio-status == "" ? #A0A0B0 : #EF5350);
                        vertical-alignment: center;
                    }
                    // Refresh device list
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_refresh.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #3C096C;
                        Image {
                            width: 16px;
                            height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../src/icons/refresh.svg");
                            image-fit: ImageFit.contain;
                        }
                        ta_refresh := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.refresh-clicked(); }
                        }
                    }
                    // Restart audio engine (applies selected devices)
                    Rectangle {
                        width: 90px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_restart.pressed ? #3C096C : #121214;
                        border-width: 1px;
                        border-color: #9D4EDD;
                        Text {
                            text: "RESTART";
                            font-size: 12px;
                            font-weight: 600;
                            color: #C77DFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ta_restart := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.restart-clicked(); }
                        }
                    }
                }

                // Row 2: output + input devices of the selected driver
                HorizontalLayout {
                    spacing: 12px;
                    alignment: LayoutAlignment.start;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    Text {
                        text: "SAÍDA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-outputs;
                        current-index: root.output-index;
                        selected(v) => {
                            root.output-selected(v);
                        }
                    }
                    Rectangle {
                        width: 12px;
                        background: transparent;
                    }
                    Text {
                        text: "ENTRADA";
                        font-size: 12px;
                        color: #A0A0B0;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        min-width: 300px;
                        model: root.available-inputs;
                        current-index: root.input-index;
                        selected(v) => {
                            root.input-selected(v);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }
                }
            }
        }

        // Main control panel
        Rectangle {
            border-radius: 22px;
            background: #1E1E24;
            border-width: 1px;
            border-color: rgba(157, 78, 221, 0.14);
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            // Front panel face (frente.jpg), clipped to the rounded corners
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: @image-url("../src/icons/frente.png");
                image-fit: cover;
            }

            // Faceplate screws on top of the panel image, one in each corner
            Image {
                width: 26px;
                height: 26px;
                x: 14px;
                y: 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 15deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: parent.width - self.width - 14px;
                y: 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 105deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: 14px;
                y: parent.height - self.height - 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 210deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }
            Image {
                width: 26px;
                height: 26px;
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 14px;
                source: @image-url("../src/icons/parafuso.png");
                image-fit: contain;
                transform-rotation: 315deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: LayoutAlignment.space-between;
                cross-axis-alignment: CrossAxisAlignment.stretch;
                height: 100%;

                // Input meter (left edge, full height)
                VerticalLayout {
                    padding-bottom: 50px;
                    spacing: 8px;
                    alignment: LayoutAlignment.end;
                    cross-axis-alignment: CrossAxisAlignment.start;
                    width: 54px;
                    vertical-stretch: 1;
                    MeterWithScale {
                        accessible-role: AccessibleRole.none;
                        level: root.input-level;
                        peak: root.input-peak;
                        vertical-stretch: 1;
                    }
                    Text { text: "IN";
                        vertical-alignment: TextVerticalAlignment.top; font-size: 11px;
                        horizontal-alignment: TextHorizontalAlignment.center; color: #A0A0B0; }
                }

                VerticalLayout {
                    spacing: 20px;
                    cross-axis-alignment: CrossAxisAlignment.stretch;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                // Preset selector: ◀ [dropdown with preset names] ▶
                HorizontalLayout {
                    alignment: LayoutAlignment.center;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    spacing: 10px;

                    Text {
                        text: "PRESET";
                        font-size: 10px;
                        letter-spacing: 2px;
                        color: Colors.aliceblue;
                        font-family: "";
                        vertical-alignment: center;
                    }

                    // Previous preset
                    Rectangle {
                        width: 26px;
                        drop-shadow-offset-y: 3px;
                        height: 24px;
                        border-radius: 12px;
                        background: ta_preset_prev.pressed ? #3C096C : #12121421;
                        border-width: 1px;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #0f0f1024;
                        Image {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../src/icons/chevron-left.svg");
                            image-fit: contain;
                        }
                        ta_preset_prev := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                let i = root.preset-index - 1;
                                let j = i < 0 ? root.preset-names.length - 1 : i;
                                root.sync-preset-index(j);
                                root.preset-selected(j);
                            }
                        }
                    }

                    // Dropdown with every preset; clicking the name opens it
                    presetCombo := ComboBox {
                        min-width: 220px;
                        model: root.preset-names;
                        selected(v) => {
                            root.preset-index = presetCombo.current-index;
                            root.preset-selected(root.preset-index);
                        }
                    }

                    // Next preset
                    Rectangle {
                        width: 26px;
                        height: 24px;
                        border-radius: 12px;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #0f0f1024;
                        drop-shadow-offset-y: 3px;
                        accessible-role: AccessibleRole.none;
                        background: ta_preset_prev.pressed ? #3C096C : #12121421;
                        border-width: 1px;
                       
                        Image {
                            width: 14px;
                            accessible-role: AccessibleRole.none;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../src/icons/chevron-right.svg");
                            image-fit: contain;
                        }
                        ta_preset_next := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                let i = root.preset-index + 1;
                                let j = i >= root.preset-names.length ? 0 : i;
                                root.sync-preset-index(j);
                                root.preset-selected(j);
                            }
                        }
                    }
                }

                // Sections side by side: Preamp | Compressor | Delay | Reverb
                HorizontalLayout {
                    spacing: 16px;
                    alignment: LayoutAlignment.center;
                    cross-axis-alignment: CrossAxisAlignment.stretch;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    // Preamp section
                    Rectangle {
                        border-radius: 14px;
                        background: #16161C;
                        border-width: 1px;
                        drop-shadow-blur: 6px;
                        border-color: rgba(157, 78, 221, 0.14);
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            alignment: LayoutAlignment.start;
                            cross-axis-alignment: CrossAxisAlignment.stretch;

                            SectionHeader {
                                label: "PREAMP";
                                show-toggle: false;
                            }

                            VerticalLayout {
                                spacing: 12px;
                                alignment: LayoutAlignment.center;
                                cross-axis-alignment: CrossAxisAlignment.center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    FaderCol {
                                        label: "DRIVE";
                                        minimum: 0.0;
                                        maximum: 24.0;
                                        value <=> root.drive;
                                        display: root.drive.round() + " dB";
                                        changed(v) => { root.drive-changed(v); }
                                    }
                                    KnobCol {
                                        label: "HPF";
                                        minimum: 20.0;
                                        maximum: 200.0;
                                        default-value: 20.0;
                                        value <=> root.hpf;
                                        display: root.freqLabel(root.hpf);
                                        changed(v) => { root.hpf-changed(v); }
                                    }
                                    KnobCol {
                                        label: "LPF";
                                        minimum: 500.0;
                                        maximum: 20000.0;
                                        default-value: 20000.0;
                                        value <=> root.lpf;
                                        display: root.freqLabel(root.lpf);
                                        changed(v) => { root.lpf-changed(v); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "AIR";
                                        minimum: 0.0;
                                        maximum: 6.0;
                                        default-value: 0.0;
                                        value <=> root.air;
                                        display: root.formatDb(root.air);
                                        changed(v) => { root.air-changed(v); }
                                    }
                                    FaderCol {
                                        label: "TRIM";
                                        minimum: -12.0;
                                        maximum: 12.0;
                                        value <=> root.output-trim;
                                        display: root.output-trim + " dB";
                                        changed(v) => { root.output-trim-changed(v); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "CHARACTER";
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        default-value: 0.35;
                                        value <=> root.tube-character;
                                        display: (root.tube-character * 100.0).round() + " %";
                                        changed(v) => { root.tube-character-changed(v); }
                                    }
                                    KnobCol {
                                        label: "SAG";
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        default-value: 0.0;
                                        value <=> root.tube-sag;
                                        display: (root.tube-sag * 100.0).round() + " %";
                                        changed(v) => { root.tube-sag-changed(v); }
                                    }
                                }
                            }
                        }
                    }

                    // Compressor section
                    Rectangle {
                        border-radius: 14px;
                        background: #16161C;
                        border-width: 1px;
                        border-color: rgba(157, 78, 221, 0.14);
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            alignment: LayoutAlignment.start;
                            cross-axis-alignment: CrossAxisAlignment.stretch;

                            SectionHeader {
                                label: "COMPRESSOR";
                                on: !root.comp-bypass;
                                toggled(v) => {
                                    root.comp-bypass = !v;
                                    root.comp-bypass-toggled(!v);
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;
                                alignment: LayoutAlignment.center;
                                cross-axis-alignment: CrossAxisAlignment.center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "THRESH";
                                        minimum: -60.0;
                                        maximum: 0.0;
                                        default-value: -18.0;
                                        value <=> root.comp-thresh;
                                        display: root.formatDb(root.comp-thresh);
                                        changed(v) => { root.comp-thresh-changed(v); }
                                    }
                                    KnobCol {
                                        label: "RATIO";
                                        minimum: 1.0;
                                        maximum: 20.0;
                                        default-value: 3.0;
                                        value <=> root.comp-ratio;
                                        display: root.ratioLabel(root.comp-ratio);
                                        changed(v) => { root.comp-ratio-changed(v); }
                                    }
                                    KnobCol {
                                        label: "ATTACK";
                                        minimum: 0.1;
                                        maximum: 100.0;
                                        default-value: 5.0;
                                        value <=> root.comp-attack;
                                        display: root.formatMs(root.comp-attack);
                                        changed(v) => { root.comp-attack-changed(v); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "RELEASE";
                                        minimum: 10.0;
                                        maximum: 1000.0;
                                        default-value: 100.0;
                                        value <=> root.comp-release;
                                        display: root.formatMs(root.comp-release);
                                        changed(v) => { root.comp-release-changed(v); }
                                    }
                                    KnobCol {
                                        label: "MAKEUP";
                                        minimum: 0.0;
                                        maximum: 24.0;
                                        default-value: 0.0;
                                        value <=> root.comp-makeup;
                                        display: root.formatDb(root.comp-makeup);
                                        changed(v) => { root.comp-makeup-changed(v); }
                                    }
                                }
                            }
                        }
                    }

                    // Stereo delay section
                    Rectangle {
                        border-radius: 14px;
                        background: #16161C;
                        border-width: 1px;
                        border-color: rgba(157, 78, 221, 0.14);
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            alignment: LayoutAlignment.start;
                            cross-axis-alignment: CrossAxisAlignment.stretch;

                            SectionHeader {
                                label: "DELAY";
                                on: !root.delay-bypass;
                                toggled(v) => {
                                    root.delay-bypass = !v;
                                    root.delay-bypass-toggled(!v);
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;
                                alignment: LayoutAlignment.center;
                                cross-axis-alignment: CrossAxisAlignment.center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "TIME";
                                        minimum: 1.0;
                                        maximum: 1000.0;
                                        default-value: 300.0;
                                        value <=> root.delay-time;
                                        display: root.formatMs(root.delay-time);
                                        changed(v) => { root.delay-time-changed(v); }
                                    }
                                    KnobCol {
                                        label: "FEEDBACK";
                                        minimum: 0.0;
                                        maximum: 90.0;
                                        default-value: 30.0;
                                        value <=> root.delay-feedback;
                                        display: round(root.delay-feedback) + " %";
                                        changed(v) => { root.delay-feedback-changed(v); }
                                    }
                                    KnobCol {
                                        label: "MIX";
                                        minimum: 0.0;
                                        maximum: 100.0;
                                        default-value: 15.0;
                                        value <=> root.delay-mix;
                                        display: round(root.delay-mix) + " %";
                                        changed(v) => { root.delay-mix-changed(v); }
                                    }
                                }
                            }
                        }
                    }

                    // Reverb section (after the delay in the chain: the echo taps
                    // fall naturally into the reverb tail).
                    Rectangle {
                        border-radius: 14px;
                        background: #16161C;
                        border-width: 1px;
                        border-color: rgba(157, 78, 221, 0.14);
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;
                            alignment: LayoutAlignment.start;
                            cross-axis-alignment: CrossAxisAlignment.stretch;

                            SectionHeader {
                                label: "REVERB";
                                on: !root.reverb-bypass;
                                toggled(v) => {
                                    root.reverb-bypass = !v;
                                    root.reverb-bypass-toggled(!v);
                                }
                            }

                            VerticalLayout {
                                spacing: 12px;
                                alignment: LayoutAlignment.center;
                                cross-axis-alignment: CrossAxisAlignment.center;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: LayoutAlignment.center;
                                    cross-axis-alignment: CrossAxisAlignment.center;

                                    KnobCol {
                                        label: "SIZE";
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        default-value: 0.5;
                                        value <=> root.reverb-size;
                                        display: round(root.reverb-size * 100) + " %";
                                        changed(v) => { root.reverb-size-changed(v); }
                                    }
                                    KnobCol {
                                        label: "DAMPING";
                                        minimum: 0.0;
                                        maximum: 1.0;
                                        default-value: 0.5;
                                        value <=> root.reverb-damping;
                                        display: round(root.reverb-damping * 100) + " %";
                                        changed(v) => { root.reverb-damping-changed(v); }
                                    }
                                    KnobCol {
                                        label: "MIX";
                                        minimum: 0.0;
                                        maximum: 100.0;
                                        default-value: 15.0;
                                        value <=> root.reverb-mix;
                                        display: round(root.reverb-mix) + " %";
                                        changed(v) => { root.reverb-mix-changed(v); }
                                    }
                                }
                            }
                        }
                    }
                }
                }

                // Output meter (right edge, full height)
                VerticalLayout {
                    padding-bottom: 50px;
                    spacing: 8px;
                    alignment: LayoutAlignment.end;
                    cross-axis-alignment: CrossAxisAlignment.start;
                    width: 54px;
                    vertical-stretch: 1;
                    MeterWithScale {
                        accessible-role: AccessibleRole.none;
                        level: root.output-level;
                        peak: root.output-peak;
                        vertical-stretch: 1;
                    }
                    Text { overflow: TextOverflow.clip;
                        text: "OUT";
                        vertical-alignment: TextVerticalAlignment.bottom;
                        wrap: TextWrap.no-wrap; font-size: 11px;
                        horizontal-alignment: TextHorizontalAlignment.center; color: #A0A0B0; }
                }
            }
        }
    }
}
